generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MatchStatus {
  UNMATCHED
  PENDING_REVIEW
  AUTO_MATCHED
  REJECTED
}

enum ScrapeRunStatus {
  STARTED
  COMPLETED
  FAILED
}

enum PromotionCategory {
  SNACKS
  ICE_CREAM
}

enum PromotionFlyerStatus {
  IMPORTED
  PARSE_FAILED
}

enum PromotionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppSessionDuration {
  ONE_DAY
  THIRTY_DAYS
}

enum ScrapeTrigger {
  ONBOARDING
  MANUAL
  SCHEDULED
}

enum ScrapeAttemptStatus {
  STARTED
  COMPLETED
  FAILED
  BLOCKED
}

model Retailer {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  baseUrl   String
  country   String   @default("SG")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings               RetailerListing[]
  scrapeRuns             ScrapeRun[]
  promotionFlyers        PromotionFlyer[]
  promotionDeals         PromotionDeal[]
  trackedProductListings TrackedProductListing[]
}

model UserProfile {
  id             String           @id @default(cuid())
  supabaseUserId String           @unique @db.Uuid
  email          String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  products       TrackedProduct[]
  sessions       AppSession[]
}

model LoginIntent {
  id         String             @id @default(cuid())
  nonceHash  String             @unique
  duration   AppSessionDuration
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([expiresAt])
}

model AppSession {
  id                String      @id @default(cuid())
  profileId         String
  supabaseSessionId String      @unique @db.Uuid
  expiresAt         DateTime
  createdAt         DateTime    @default(now())
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, expiresAt])
}

model TrackedProduct {
  id        String   @id @default(cuid())
  ownerId   String
  slug      String
  name      String
  brand     String
  family    String
  flavour   String?
  packCount Int
  unitSize  Float
  unit      String
  totalSize Float
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    UserProfile             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings TrackedProductListing[]

  @@unique([ownerId, slug])
  @@index([ownerId, isActive])
}

model CanonicalProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  brand       String
  family      String
  flavour     String?
  packCount   Int      @default(1)
  unitSize    Float
  unit        String
  totalSize   Float
  searchTerms String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings RetailerListing[]
}

model RetailerListing {
  id                 String      @id @default(cuid())
  retailerId         String
  canonicalProductId String?
  retailerSku        String?
  titleRaw           String
  brandRaw           String?
  imageUrl           String?
  productUrl         String
  normalizedBrand    String?
  normalizedFamily   String?
  normalizedFlavour  String?
  packCount          Int?
  unitSize           Float?
  unit               String?
  totalSize          Float?
  matchStatus        MatchStatus @default(UNMATCHED)
  matchConfidence    Float?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  retailer               Retailer                @relation(fields: [retailerId], references: [id])
  canonicalProduct       CanonicalProduct?       @relation(fields: [canonicalProductId], references: [id])
  priceSnapshots         PriceSnapshot[]
  trackedProductListings TrackedProductListing[]
  scrapeAttempts         ScrapeAttempt[]

  @@unique([retailerId, productUrl])
  @@unique([id, retailerId])
  @@index([canonicalProductId])
}

model TrackedProductListing {
  id                String   @id @default(cuid())
  trackedProductId  String
  retailerListingId String
  retailerId        String
  createdAt         DateTime @default(now())

  trackedProduct  TrackedProduct  @relation(fields: [trackedProductId], references: [id], onDelete: Cascade)
  retailerListing RetailerListing @relation(fields: [retailerListingId, retailerId], references: [id, retailerId], onDelete: Restrict)
  retailer        Retailer        @relation(fields: [retailerId], references: [id], onDelete: Restrict)

  @@unique([trackedProductId, retailerId])
  @@unique([trackedProductId, retailerListingId])
  @@index([retailerListingId])
  @@index([retailerId])
}

model ScrapeAttempt {
  id                String              @id @default(cuid())
  retailerListingId String
  trigger           ScrapeTrigger
  status            ScrapeAttemptStatus @default(STARTED)
  errorCategory     String?
  errorMessage      String?
  snapshotStored    Boolean             @default(false)
  startedAt         DateTime            @default(now())
  completedAt       DateTime?

  retailerListing RetailerListing @relation(fields: [retailerListingId], references: [id], onDelete: Cascade)

  @@index([retailerListingId, startedAt])
}

model PriceSnapshot {
  id                String   @id @default(cuid())
  retailerListingId String
  scrapeRunId       String?
  price             Decimal  @db.Decimal(10, 2)
  originalPrice     Decimal? @db.Decimal(10, 2)
  unitPrice         Decimal? @db.Decimal(12, 5)
  promotionText     String?
  currency          String   @default("SGD")
  isAvailable       Boolean  @default(true)
  capturedAt        DateTime @default(now())

  retailerListing RetailerListing @relation(fields: [retailerListingId], references: [id])
  scrapeRun       ScrapeRun?      @relation(fields: [scrapeRunId], references: [id])

  @@index([capturedAt])
}

model ScrapeRun {
  id           String          @id @default(cuid())
  retailerId   String?
  status       ScrapeRunStatus @default(STARTED)
  query        String?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  errorMessage String?
  itemsFound   Int             @default(0)
  itemsStored  Int             @default(0)

  retailer       Retailer?       @relation(fields: [retailerId], references: [id])
  priceSnapshots PriceSnapshot[]
}

model PromotionFlyer {
  id           String               @id @default(cuid())
  seriesKey    String
  retailerId   String
  title        String
  sourceUrl    String
  assetUrl     String
  assetPath    String
  assetHash    String               @unique
  validFrom    DateTime?
  validTo      DateTime?
  fetchedAt    DateTime             @default(now())
  status       PromotionFlyerStatus @default(IMPORTED)
  errorMessage String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  retailer Retailer        @relation(fields: [retailerId], references: [id])
  deals    PromotionDeal[]

  @@index([retailerId])
  @@index([seriesKey, validFrom])
  @@index([seriesKey, validTo])
  @@index([validFrom, validTo])
}

model PromotionDeal {
  id           String                @id @default(cuid())
  flyerId      String
  retailerId   String
  category     PromotionCategory
  rawTitle     String
  packText     String?
  priceText    String?
  parsedPrice  Decimal?              @db.Decimal(10, 2)
  promoText    String?
  pageNumber   Int
  sourceX      Float?
  sourceY      Float?
  sourceWidth  Float?
  sourceHeight Float?
  confidence   Float
  reviewStatus PromotionReviewStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  flyer    PromotionFlyer @relation(fields: [flyerId], references: [id])
  retailer Retailer       @relation(fields: [retailerId], references: [id])

  @@index([reviewStatus])
  @@index([category])
  @@index([retailerId])
  @@index([flyerId])
}
